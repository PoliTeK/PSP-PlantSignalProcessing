  73:../libs/PoliTeKDSP/libs/DaisySP/Source/Control/adsr.h ****     */
  74:../libs/PoliTeKDSP/libs/DaisySP/Source/Control/adsr.h ****     inline void SetSustainLevel(float sus_level)
