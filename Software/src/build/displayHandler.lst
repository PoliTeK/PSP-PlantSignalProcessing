  61:Display/oled_ssd130xDMA.h **** 
  62:Display/oled_ssd130xDMA.h **** // --- PARTE 2: Il Driver (Gestione Grafica) ---
  63:Display/oled_ssd130xDMA.h **** template <size_t width, size_t height>
  64:Display/oled_ssd130xDMA.h **** class SSD1306DmaDriver {
  65:Display/oled_ssd130xDMA.h **** public:
  66:Display/oled_ssd130xDMA.h ****     struct Config {
  67:Display/oled_ssd130xDMA.h ****         typename SSD1306I2cDmaTransport::Config transport_config;
  68:Display/oled_ssd130xDMA.h ****     };
  69:Display/oled_ssd130xDMA.h **** 
  70:Display/oled_ssd130xDMA.h ****     void Init(Config config) {
  71:Display/oled_ssd130xDMA.h ****         transport_.Init(config.transport_config);
  72:Display/oled_ssd130xDMA.h **** 
  73:Display/oled_ssd130xDMA.h ****         // Sequenza di inizializzazione standard SSD1306
  74:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xAE); // Display Off
  75:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD5); transport_.SendCommand(0x80); // Clock Divide
  76:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA8); transport_.SendCommand(0x3F); // Multiplex Ratio (64 pixel)
  77:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD3); transport_.SendCommand(0x00); // Display Offset
  78:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0x40); // Start Line
  79:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0x8D); transport_.SendCommand(0x14); // Charge Pump
  80:Display/oled_ssd130xDMA.h ****         
  81:Display/oled_ssd130xDMA.h ****         // COMANDO CHIAVE: Imposta l'Addressing Orizzontale
  82:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0x20); transport_.SendCommand(0x00); 
  83:Display/oled_ssd130xDMA.h ****         
  84:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA1); // Segment Remap
  85:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xC8); // COM Direction
  86:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xDA); transport_.SendCommand(0x12); // COM Pins
ARM GAS  C:\Users\skipi\AppData\Local\Temp\cc2P2RPe.s 			page 3


  87:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0x81); transport_.SendCommand(0xCF); // Contrast
  88:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD9); transport_.SendCommand(0xF1); // Pre-charge
  89:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xDB); transport_.SendCommand(0x40); // VCOM Detect
  90:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA4); // All On Resume
  91:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA6); // Normal Display
  92:Display/oled_ssd130xDMA.h ****         transport_.SendCommand(0xAF); // Display On
  93:Display/oled_ssd130xDMA.h ****     }
  94:Display/oled_ssd130xDMA.h **** 
  95:Display/oled_ssd130xDMA.h ****     void DrawPixel(uint_fast8_t x, uint_fast8_t y, bool on) {
  96:Display/oled_ssd130xDMA.h ****         if(x >= width || y >= height) return;
  97:Display/oled_ssd130xDMA.h ****         if(on) buffer_[x + (y / 8) * width] |= (1 << (y % 8));
  98:Display/oled_ssd130xDMA.h ****         else   buffer_[x + (y / 8) * width] &= ~(1 << (y % 8));
  99:Display/oled_ssd130xDMA.h ****     }
 100:Display/oled_ssd130xDMA.h **** 
 101:Display/oled_ssd130xDMA.h ****     void Fill(bool on) {
 102:Display/oled_ssd130xDMA.h ****         memset(buffer_, on ? 0xFF : 0x00, sizeof(buffer_));
 103:Display/oled_ssd130xDMA.h ****     }
 104:Display/oled_ssd130xDMA.h **** 
 105:Display/oled_ssd130xDMA.h ****     size_t Width() const { return width; }
 106:Display/oled_ssd130xDMA.h ****     size_t Height() const { return height; }
 107:Display/oled_ssd130xDMA.h ****     bool UpdateFinished() { return !updating_; }
 108:Display/oled_ssd130xDMA.h **** 
 109:Display/oled_ssd130xDMA.h ****     void Update() {
 110:Display/oled_ssd130xDMA.h ****         if (!updating_) {
 111:Display/oled_ssd130xDMA.h ****             updating_ = true;
 112:Display/oled_ssd130xDMA.h ****             
 113:Display/oled_ssd130xDMA.h ****             // Riposiziona il cursore dell'OLED in alto a sinistra (Colonna 0, Pagina 0)
 114:Display/oled_ssd130xDMA.h ****             uint8_t reset_cmds[] = {0x21, 0, 127, 0x22, 0, 7}; 
 115:Display/oled_ssd130xDMA.h ****             transport_.SendCommands(reset_cmds, 6);
 116:Display/oled_ssd130xDMA.h ****             
 117:Display/oled_ssd130xDMA.h ****             transport_.SendDataDma(buffer_, sizeof(buffer_), DmaCallback, this);
 118:Display/oled_ssd130xDMA.h ****         }
 119:Display/oled_ssd130xDMA.h ****     }
 120:Display/oled_ssd130xDMA.h **** 
 121:Display/oled_ssd130xDMA.h **** private:
 122:Display/oled_ssd130xDMA.h ****     SSD1306I2cDmaTransport transport_;
 123:Display/oled_ssd130xDMA.h ****     uint8_t buffer_[width * height / 8];
 124:Display/oled_ssd130xDMA.h ****     volatile bool updating_ = false;
 125:Display/oled_ssd130xDMA.h **** 
 126:Display/oled_ssd130xDMA.h ****     // Questa funzione viene chiamata automaticamente dall'hardware quando il DMA ha finito
