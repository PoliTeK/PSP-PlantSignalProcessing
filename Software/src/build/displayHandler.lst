  27:Display/oled_ssd130xDMA.h ****     }
  28:Display/oled_ssd130xDMA.h **** 
  29:Display/oled_ssd130xDMA.h ****     void SendCommand(uint8_t cmd) {
ARM GAS  C:\Users\skipi\AppData\Local\Temp\cc2P2RPe.s 			page 2


  30:Display/oled_ssd130xDMA.h ****         uint8_t buf[2] = {0x00, cmd};
  31:Display/oled_ssd130xDMA.h ****         i2c_.TransmitBlocking(_i2c_address_, buf, 2, 100);
  32:Display/oled_ssd130xDMA.h ****     }
  33:Display/oled_ssd130xDMA.h **** 
  34:Display/oled_ssd130xDMA.h ****     void SendCommands(uint8_t* cmds, size_t size) {
  35:Display/oled_ssd130xDMA.h ****         for(size_t i = 0; i < size; i++) {
  36:Display/oled_ssd130xDMA.h ****             SendCommand(cmds[i]);
  37:Display/oled_ssd130xDMA.h ****         }
  38:Display/oled_ssd130xDMA.h ****     }
  39:Display/oled_ssd130xDMA.h **** 
  40:Display/oled_ssd130xDMA.h ****     void SendDataDma(uint8_t* buff, size_t size, I2CHandle::CallbackFunctionPtr callback, void* con
  41:Display/oled_ssd130xDMA.h ****         // 1. Prepara il pacchetto unendo il byte di comando (0x40) e i byte grafici
  42:Display/oled_ssd130xDMA.h ****         _dma_buffer_[0] = 0x40;
  43:Display/oled_ssd130xDMA.h ****         memcpy(&_dma_buffer_[1], buff, size);
  44:Display/oled_ssd130xDMA.h ****         
  45:Display/oled_ssd130xDMA.h ****         // 2. Forza la CPU a scrivere le modifiche (appena fatte col memcpy) nella RAM fisica
  46:Display/oled_ssd130xDMA.h ****         // In questo modo il DMA hardware non leggerà dati obsoleti.
  47:Display/oled_ssd130xDMA.h ****         dsy_dma_clear_cache_for_buffer(_dma_buffer_, size + 1);
  48:Display/oled_ssd130xDMA.h ****         
  49:Display/oled_ssd130xDMA.h ****         // 3. Avvia il trasferimento hardware in background
  50:Display/oled_ssd130xDMA.h ****         i2c_.TransmitDma(_i2c_address_, _dma_buffer_, size + 1, callback, context);
  51:Display/oled_ssd130xDMA.h ****     }
  52:Display/oled_ssd130xDMA.h **** 
