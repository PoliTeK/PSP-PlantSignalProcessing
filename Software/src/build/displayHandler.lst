  54:Display/oled_ssd130xDMA.h ****     daisy::I2CHandle i2c_;
  55:Display/oled_ssd130xDMA.h ****     uint8_t _i2c_address_;
  56:Display/oled_ssd130xDMA.h ****     
  57:Display/oled_ssd130xDMA.h ****     // Alloca 1025 byte nella zona di memoria D2, ottimizzata per il DMA
  58:Display/oled_ssd130xDMA.h ****     uint8_t _dma_buffer_[1025];
  59:Display/oled_ssd130xDMA.h **** };
