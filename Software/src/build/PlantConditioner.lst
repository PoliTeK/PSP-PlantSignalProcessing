  42:PSP/PlantConditioner.cpp **** void PlantConditioner::setScale(enum Notes root_note, enum ScaleType scale_type) {
  43:PSP/PlantConditioner.cpp ****     // Copia della scala base
  44:PSP/PlantConditioner.cpp ****     switch (scale_type) 
  45:PSP/PlantConditioner.cpp ****     {
  46:PSP/PlantConditioner.cpp ****     case Major:
  47:PSP/PlantConditioner.cpp ****         _scaleLength = 7;
  48:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 7; i++) _scale[i] = _majorScale[i];
  49:PSP/PlantConditioner.cpp ****         break;
  50:PSP/PlantConditioner.cpp ****     case MinorNat:
  51:PSP/PlantConditioner.cpp ****         _scaleLength = 7;
  52:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 7; i++) _scale[i] = _minorNScale[i];
  53:PSP/PlantConditioner.cpp ****         break;
  54:PSP/PlantConditioner.cpp ****     case MinorArm:
  55:PSP/PlantConditioner.cpp ****         _scaleLength = 7;
  56:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 7; i++) _scale[i] = _minorAScale[i];
  57:PSP/PlantConditioner.cpp ****         break;
  58:PSP/PlantConditioner.cpp ****     case MinorMel:
  59:PSP/PlantConditioner.cpp ****         _scaleLength = 7;
  60:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 7; i++) _scale[i] = _minorMScale[i];
  61:PSP/PlantConditioner.cpp ****         break;
  62:PSP/PlantConditioner.cpp ****     case Pentatonic:
  63:PSP/PlantConditioner.cpp ****         _scaleLength = 5;
  64:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 5; i++) _scale[i] = _pentatonicScale[i];
  65:PSP/PlantConditioner.cpp ****         break;
  66:PSP/PlantConditioner.cpp ****     case Chromatic:
  67:PSP/PlantConditioner.cpp ****         _scaleLength = 12;
  68:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 12; i++) _scale[i] = _chromaticScale[i];
  69:PSP/PlantConditioner.cpp ****         break;
ARM GAS  C:\Users\skipi\AppData\Local\Temp\ccSuQdZt.s 			page 19


  70:PSP/PlantConditioner.cpp ****     case Esatonic:
  71:PSP/PlantConditioner.cpp ****         _scaleLength = 6;
  72:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 6; i++) _scale[i] = _esatonic[i];
  73:PSP/PlantConditioner.cpp ****         break;
  74:PSP/PlantConditioner.cpp ****     default:
  75:PSP/PlantConditioner.cpp ****         _scaleLength = 7;
  76:PSP/PlantConditioner.cpp ****         for (int i = 0; i < 7; i++) _scale[i] = _majorScale[i];
  77:PSP/PlantConditioner.cpp ****         break;
  78:PSP/PlantConditioner.cpp ****     }
  79:PSP/PlantConditioner.cpp **** 
  80:PSP/PlantConditioner.cpp ****     // Trasposizione (Pitch Shifting) in base alla nota fondamentale
  81:PSP/PlantConditioner.cpp ****     // powf(2, n/12) calcola il rapporto semitonale
  82:PSP/PlantConditioner.cpp ****     float transposition = powf(2.0f, (float)root_note / 12.0f);
