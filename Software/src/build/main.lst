  41:Display/../Components/oled_ssd130xDMA.h ****         // 1. Prepara il pacchetto unendo il byte di comando (0x40) e i byte grafici
  42:Display/../Components/oled_ssd130xDMA.h ****         _dma_buffer_[0] = 0x40;
  43:Display/../Components/oled_ssd130xDMA.h ****         memcpy(&_dma_buffer_[1], buff, size);
  44:Display/../Components/oled_ssd130xDMA.h ****         
  45:Display/../Components/oled_ssd130xDMA.h ****         // 2. Forza la CPU a scrivere le modifiche (appena fatte col memcpy) nella RAM fisica
  46:Display/../Components/oled_ssd130xDMA.h ****         // In questo modo il DMA hardware non leggerà dati obsoleti.
  47:Display/../Components/oled_ssd130xDMA.h ****         dsy_dma_clear_cache_for_buffer(_dma_buffer_, size + 1);
