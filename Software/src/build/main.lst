  62:Display/../Components/oled_ssd130xDMA.h **** // --- PARTE 2: Il Driver (Gestione Grafica) ---
  63:Display/../Components/oled_ssd130xDMA.h **** template <size_t width, size_t height>
  64:Display/../Components/oled_ssd130xDMA.h **** class SSD1306DmaDriver {
  65:Display/../Components/oled_ssd130xDMA.h **** public:
  66:Display/../Components/oled_ssd130xDMA.h ****     struct Config {
  67:Display/../Components/oled_ssd130xDMA.h ****         typename SSD1306I2cDmaTransport::Config transport_config;
  68:Display/../Components/oled_ssd130xDMA.h ****     };
  69:Display/../Components/oled_ssd130xDMA.h **** 
  70:Display/../Components/oled_ssd130xDMA.h ****     void Init(Config config) {
  71:Display/../Components/oled_ssd130xDMA.h ****         transport_.Init(config.transport_config);
  72:Display/../Components/oled_ssd130xDMA.h **** 
  73:Display/../Components/oled_ssd130xDMA.h ****         // Sequenza di inizializzazione standard SSD1306
  74:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xAE); // Display Off
  75:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD5); transport_.SendCommand(0x80); // Clock Divide
  76:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA8); transport_.SendCommand(0x3F); // Multiplex Ratio (64 pixel)
  77:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD3); transport_.SendCommand(0x00); // Display Offset
  78:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0x40); // Start Line
  79:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0x8D); transport_.SendCommand(0x14); // Charge Pump
