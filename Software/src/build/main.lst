   7:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** namespace daisy
   8:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** {
   9:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** /** @brief Non Volatile storage class for persistent settings on an external flash device.
  10:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  *  @author shensley
  11:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  * 
  12:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  *  Storage occupied by the struct will be one word larger than 
  13:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  *  the SettingStruct used. The extra word is used to store the
  14:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  *  state of the data, and whether it's been overwritten or not.
  15:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  * 
  16:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  *  \todo - Make Save() non-blocking
  17:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  *  \todo - Add wear leveling
  18:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  * 
  19:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****  **/
  20:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** template <typename SettingStruct>
  21:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** class PersistentStorage
  22:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** {
  23:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****   public:
  24:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     /** State of the storage. 
  25:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  When created, prior to initialiation, the state will be Unknown
  26:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  
  27:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  During initialization, the state will be changed to either FACTORY,
  28:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  or USER. 
  29:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      * 
  30:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  If this is the first time these settings are being written to the
  31:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  target address, the defaults will be written to that location,
  32:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  and the state will be set to FACTORY.
  33:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      * 
  34:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  Once the first user-trigger save has been made, the state will be 
  35:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  updated to USER to indicate that the defaults have overwritten.
  36:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      */
  37:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     enum class State
ARM GAS  C:\Users\skipi\AppData\Local\Temp\ccCETE1r.s 			page 92


  38:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     {
  39:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         UNKNOWN = 0,
  40:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         FACTORY = 1,
  41:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         USER    = 2,
  42:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     };
  43:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** 
  44:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     /** Constructor for storage class 
  45:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  \param qspi reference to the hardware qspi peripheral.
  46:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      */
  47:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     PersistentStorage(QSPIHandle &qspi)
  48:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     : qspi_(qspi),
  49:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****       address_offset_(0),
  50:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****       default_settings_(),
  51:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****       settings_(),
  52:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****       state_(State::UNKNOWN)
  53:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     {
  54:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     }
  55:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** 
  56:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     /** Initialize Storage class
  57:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *
  58:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  The values in this class will be stored as the default
  59:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  for restoration to 'factory' settings.
  60:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *
  61:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  \param defaults should be a setting structure containing the default values.
  62:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *      this will be updated to contain the stored data.
  63:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *  \param address_offset offset for location on the QSPI chip (offset to base address of devic
  64:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      *      This defaults to the first address on the chip, and will be masked to the nearest multi
  65:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****      **/
  66:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     void Init(const SettingStruct &defaults, uint32_t address_offset = 0)
  67:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     {
  68:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         default_settings_ = defaults;
  69:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         settings_         = defaults;
  70:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         address_offset_   = address_offset & (uint32_t)(~0xff);
  71:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         auto storage_data
  72:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             = reinterpret_cast<SaveStruct *>(qspi_.GetData(address_offset_));
  73:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** 
  74:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         // check to see if the state is already in use.
  75:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         State cur_state = storage_data->storage_state;
  76:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         if(cur_state != State::FACTORY && cur_state != State::USER)
  77:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         {
  78:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             // Initialize the Data store State::FACTORY, and the DefaultSettings
  79:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             state_ = State::FACTORY;
  80:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             StoreSettingsIfChanged();
  81:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         }
  82:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         else
  83:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         {
  84:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             state_    = cur_state;
