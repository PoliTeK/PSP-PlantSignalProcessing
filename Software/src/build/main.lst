  76:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         if(cur_state != State::FACTORY && cur_state != State::USER)
  77:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         {
  78:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             // Initialize the Data store State::FACTORY, and the DefaultSettings
  79:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             state_ = State::FACTORY;
  80:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             StoreSettingsIfChanged();
  81:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         }
  82:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         else
  83:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         {
  84:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             state_    = cur_state;
  85:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****             settings_ = storage_data->user_data;
  86:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****         }
  87:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     }
  88:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h **** 
  89:../libs/PoliTeKDSP/libs/libDaisy/src/util/PersistentStorage.h ****     /** Returns the state of the Persistent Data */
