  39:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h ****  *  sai.Init(sai_config);
  40:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h ****  *  // Now you can use it:
  41:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h ****  *  sai.StartDma(. . .);
  42:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h ****  */
  43:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h **** class SaiHandle
  44:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h **** {
  45:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h ****   public:
  46:../libs/PoliTeKDSP/libs/libDaisy/src/per/sai.h ****     /** Contains settings for initialising an SAI Interface */
