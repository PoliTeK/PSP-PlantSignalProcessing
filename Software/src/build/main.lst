 182:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     {
 183:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         // In case of UART Error, (particularly
 184:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         //  overrun error), UART disables itself.
 185:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         // Flush the buff, and restart.
