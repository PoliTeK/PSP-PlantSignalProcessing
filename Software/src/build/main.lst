  71:Display/../Components/oled_ssd130xDMA.h ****         transport_.Init(config.transport_config);
  72:Display/../Components/oled_ssd130xDMA.h **** 
  73:Display/../Components/oled_ssd130xDMA.h ****         // Sequenza di inizializzazione standard SSD1306
  74:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xAE); // Display Off
  75:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD5); transport_.SendCommand(0x80); // Clock Divide
  76:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA8); transport_.SendCommand(0x3F); // Multiplex Ratio (64 pixel)
  77:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD3); transport_.SendCommand(0x00); // Display Offset
  78:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0x40); // Start Line
  79:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0x8D); transport_.SendCommand(0x14); // Charge Pump
  80:Display/../Components/oled_ssd130xDMA.h ****         
  81:Display/../Components/oled_ssd130xDMA.h ****         // COMANDO CHIAVE: Imposta l'Addressing Orizzontale
  82:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0x20); transport_.SendCommand(0x00); 
  83:Display/../Components/oled_ssd130xDMA.h ****         
  84:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA1); // Segment Remap
  85:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xC8); // COM Direction
  86:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xDA); transport_.SendCommand(0x12); // COM Pins
  87:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0x81); transport_.SendCommand(0xCF); // Contrast
  88:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xD9); transport_.SendCommand(0xF1); // Pre-charge
  89:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xDB); transport_.SendCommand(0x40); // VCOM Detect
  90:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA4); // All On Resume
  91:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xA6); // Normal Display
  92:Display/../Components/oled_ssd130xDMA.h ****         transport_.SendCommand(0xAF); // Display On
  93:Display/../Components/oled_ssd130xDMA.h ****     }
  94:Display/../Components/oled_ssd130xDMA.h **** 
  95:Display/../Components/oled_ssd130xDMA.h ****     void DrawPixel(uint_fast8_t x, uint_fast8_t y, bool on) {
