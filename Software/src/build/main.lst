   6:Display/../Components/oled_ssd130xDMA.h **** namespace daisy {
   7:Display/../Components/oled_ssd130xDMA.h **** 
   8:Display/../Components/oled_ssd130xDMA.h **** class SSD1306I2cDmaTransport {
   9:Display/../Components/oled_ssd130xDMA.h **** public:
  10:Display/../Components/oled_ssd130xDMA.h ****     struct Config {
  11:Display/../Components/oled_ssd130xDMA.h ****         Config() { Defaults(); }
  12:Display/../Components/oled_ssd130xDMA.h ****         I2CHandle::Config i2c_config;
  13:Display/../Components/oled_ssd130xDMA.h ****         uint8_t i2c_address;
  14:Display/../Components/oled_ssd130xDMA.h ****         void Defaults() {
  15:Display/../Components/oled_ssd130xDMA.h ****             i2c_config.periph = I2CHandle::Config::Peripheral::I2C_1;
  16:Display/../Components/oled_ssd130xDMA.h ****             i2c_config.speed = I2CHandle::Config::Speed::I2C_1MHZ;
  17:Display/../Components/oled_ssd130xDMA.h ****             i2c_config.mode = I2CHandle::Config::Mode::I2C_MASTER;
  18:Display/../Components/oled_ssd130xDMA.h ****             i2c_config.pin_config.scl = daisy::Pin(PORTB, 8);
  19:Display/../Components/oled_ssd130xDMA.h ****             i2c_config.pin_config.sda = daisy::Pin(PORTB, 9);
  20:Display/../Components/oled_ssd130xDMA.h ****             i2c_address = 0x3C;
  21:Display/../Components/oled_ssd130xDMA.h ****         }
  22:Display/../Components/oled_ssd130xDMA.h ****     };
  23:Display/../Components/oled_ssd130xDMA.h **** 
  24:Display/../Components/oled_ssd130xDMA.h ****     void Init(const Config& config) {
  25:Display/../Components/oled_ssd130xDMA.h ****         _i2c_address_ = config.i2c_address;
  26:Display/../Components/oled_ssd130xDMA.h ****         i2c_.Init(config.i2c_config);
  27:Display/../Components/oled_ssd130xDMA.h ****     }
  28:Display/../Components/oled_ssd130xDMA.h **** 
  29:Display/../Components/oled_ssd130xDMA.h ****     void SendCommand(uint8_t cmd) {
  30:Display/../Components/oled_ssd130xDMA.h ****         uint8_t buf[2] = {0x00, cmd};
  31:Display/../Components/oled_ssd130xDMA.h ****         i2c_.TransmitBlocking(_i2c_address_, buf, 2, 100);
  32:Display/../Components/oled_ssd130xDMA.h ****     }
  33:Display/../Components/oled_ssd130xDMA.h **** 
  34:Display/../Components/oled_ssd130xDMA.h ****     void SendCommands(uint8_t* cmds, size_t size) {
  35:Display/../Components/oled_ssd130xDMA.h ****         for(size_t i = 0; i < size; i++) {
  36:Display/../Components/oled_ssd130xDMA.h ****             SendCommand(cmds[i]);
  37:Display/../Components/oled_ssd130xDMA.h ****         }
  38:Display/../Components/oled_ssd130xDMA.h ****     }
  39:Display/../Components/oled_ssd130xDMA.h **** 
  40:Display/../Components/oled_ssd130xDMA.h ****     void SendDataDma(uint8_t* buff, size_t size, I2CHandle::CallbackFunctionPtr callback, void* con
  41:Display/../Components/oled_ssd130xDMA.h ****         // 1. Prepara il pacchetto unendo il byte di comando (0x40) e i byte grafici
  42:Display/../Components/oled_ssd130xDMA.h ****         _dma_buffer_[0] = 0x40;
  43:Display/../Components/oled_ssd130xDMA.h ****         memcpy(&_dma_buffer_[1], buff, size);
  44:Display/../Components/oled_ssd130xDMA.h ****         
  45:Display/../Components/oled_ssd130xDMA.h ****         // 2. Forza la CPU a scrivere le modifiche (appena fatte col memcpy) nella RAM fisica
  46:Display/../Components/oled_ssd130xDMA.h ****         // In questo modo il DMA hardware non leggerà dati obsoleti.
  47:Display/../Components/oled_ssd130xDMA.h ****         dsy_dma_clear_cache_for_buffer(_dma_buffer_, size + 1);
  48:Display/../Components/oled_ssd130xDMA.h ****         
  49:Display/../Components/oled_ssd130xDMA.h ****         // 3. Avvia il trasferimento hardware in background
  50:Display/../Components/oled_ssd130xDMA.h ****         i2c_.TransmitDma(_i2c_address_, _dma_buffer_, size + 1, callback, context);
  51:Display/../Components/oled_ssd130xDMA.h ****     }
  52:Display/../Components/oled_ssd130xDMA.h **** 
  53:Display/../Components/oled_ssd130xDMA.h **** private:
  54:Display/../Components/oled_ssd130xDMA.h ****     daisy::I2CHandle i2c_;
  55:Display/../Components/oled_ssd130xDMA.h ****     uint8_t _i2c_address_;
  56:Display/../Components/oled_ssd130xDMA.h ****     
  57:Display/../Components/oled_ssd130xDMA.h ****     // Alloca 1025 byte nella zona di memoria D2, ottimizzata per il DMA
  58:Display/../Components/oled_ssd130xDMA.h ****     uint8_t _dma_buffer_[1025];
  59:Display/../Components/oled_ssd130xDMA.h **** };
