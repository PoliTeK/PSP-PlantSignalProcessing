 179:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h **** 
 180:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     /** Start listening */
 181:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     void Listen()
 182:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     {
 183:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         // In case of UART Error, (particularly
 184:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         //  overrun error), UART disables itself.
 185:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         // Flush the buff, and restart.
 186:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         if(!transport_.RxActive())
 187:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         {
 188:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****             parser_.Reset();
 189:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****             transport_.FlushRx();
 190:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****             StartReceive();
 191:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****         }
 192:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     }
 193:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h **** 
 194:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     /** Checks if there are unhandled messages in the queue
 195:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     \return True if there are events to be handled, else false.
 196:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****      */
 197:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     bool HasEvents() const { return event_q_.GetNumElements() > 0; }
 198:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h **** 
 199:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h ****     bool RxActive() { return transport_.RxActive(); }
 200:../libs/PoliTeKDSP/libs/libDaisy/src/hid/midi.h **** 
