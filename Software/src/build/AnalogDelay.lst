  69:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** /** From Musicdsp.org "Fast power and root estimates for 32bit floats)
  70:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** Original code by Stefan Stenzel
  71:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** These are approximations
  72:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** */
  73:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float fastpower(float f, int n)
  74:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
  75:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     long *lp, l;
  76:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     lp = (long *)(&f);
  77:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l  = *lp;
  78:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l -= 0x3F800000;
  79:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l <<= (n - 1);
  80:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l += 0x3F800000;
  81:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     *lp = l;
  82:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return f;
  83:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** }
  84:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
  85:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float fastroot(float f, int n)
  86:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
  87:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     long *lp, l;
  88:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     lp = (long *)(&f);
  89:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l  = *lp;
  90:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l -= 0x3F800000;
  91:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l >>= (n - 1);
  92:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     l += 0x3F800000;
  93:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     *lp = l;
  94:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return f;
  95:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** }
  96:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
  97:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** /** Significantly more efficient than fmodf(x, 1.0f) for calculating
  98:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****  *  the decimal part of a floating point value.
  99:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****  */
 100:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float fastmod1f(float x)
 101:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
 102:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return x - floorf(x);
 103:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** }
 104:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
 105:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** /** From http://openaudio.blogspot.com/2017/02/faster-log10-and-pow.html
 106:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** No approximation, pow10f(x) gives a 90% speed increase over powf(10.f, x)
 107:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** */
 108:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float pow10f(float f)
 109:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
 110:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return expf(2.302585092994046f * f);
 111:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** }
 112:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
 113:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** /* Original code for fastlog2f by Dr. Paul Beckmann from the ARM community forum, adapted from the 
 114:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** About 25% performance increase over std::log10f
ARM GAS  C:\Users\skipi\AppData\Local\Temp\cc09pqTg.s 			page 36


 115:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** */
 116:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float fastlog2f(float f)
 117:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
 118:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     float frac;
 119:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     int   exp;
 120:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     frac = frexpf(fabsf(f), &exp);
 121:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     f    = 1.23149591368684f;
 122:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     f *= frac;
 123:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     f += -4.11852516267426f;
 124:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     f *= frac;
