 144:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
 145:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** /** one pole lpf
 146:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** out is passed by reference, and must be retained between
 147:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** calls to properly filter the signal
 148:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** coeff can be calculated:
 149:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** coeff = 1.0 / (time * sample_rate) ; where time is in seconds
 150:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** */
 151:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline void fonepole(float &out, float in, float coeff)
 152:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
