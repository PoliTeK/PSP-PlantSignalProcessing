 126:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     f *= frac;
 127:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     f += -3.13396450166353f;
 128:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     f += exp;
 129:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return (f);
 130:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** }
 131:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
 132:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float fastlog10f(float f)
 133:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
 134:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return fastlog2f(f) * 0.3010299956639812f;
 135:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** }
 136:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
 137:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** /** Midi to frequency helper
 138:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** */
 139:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float mtof(float m)
 140:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
 141:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return powf(2, (m - 69.0f) / 12.0f) * 440.0f;
