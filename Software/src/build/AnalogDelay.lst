  49:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** 
  50:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** Based on "Pitch Shifting" from ucsd.edu 
  51:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** 
  52:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** t = 1 - ((s *f) / R)
  53:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** 
  54:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** where:
  55:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h ****     s is the size of the delay
  56:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h ****     f is the frequency of the lfo
  57:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h ****     r is the sample_rate
  58:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** 
  59:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** solving for t = 12.0
  60:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** f = (12 - 1) * 48000 / SHIFT_BUFFER_SIZE;
  61:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** 
  62:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** \todo - move hash_xs32 and myrand to dsp.h and give appropriate names
  63:../libs/PoliTeKDSP/libs/DaisySP/Source/Effects/pitchshifter.h **** */
