  13:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         
  14:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_TRI:
  15:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         {
  16:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Generazione del Triangolo base
