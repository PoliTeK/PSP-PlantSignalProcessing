  48:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             break;
  49:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         }
  50:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         
  51:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_RAMP: out = ((phase_ * 2.0f)) - 1.0f; break;
  52:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_SQUARE:
  53:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         {
  54:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // shape_ (0.0 -> 1.0)
  55:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Se shape_ = 1.0 -> duty_cycle = 0.5 (50%, onda quadra perfetta)
  56:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Se shape_ = 0.0 -> duty_cycle = 0.05 (5%, impulso strettissimo e nasale)
  57:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             float duty_cycle = 0.5f - (shape_ * 0.45f);
  58:../libs/PoliTeKDSP/Oscillators/oscillator.cpp **** 
  59:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out = phase_ < duty_cycle ? 1.0f : -1.0f;
  60:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             break;
  61:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         }
  62:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         
  63:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_POLYBLEP_TRI:
  64:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             t   = phase_;
  65:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out = phase_ < 0.5f ? 1.0f : -1.0f;
  66:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out += Polyblep(phase_inc_, t);
