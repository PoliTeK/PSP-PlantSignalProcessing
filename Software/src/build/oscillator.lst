  32:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         }
  33:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         
  34:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_SAW:
  35:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         {
  36:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // MORPHING SAW (Simmetria Variabile)
  37:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // peak determina dove si trova il picco dell'onda
  38:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             float peak = shape_;
  39:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  40:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Limitiamo il picco per evitare click estremi o divisioni per zero
  41:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             if(peak < 0.01f) peak = 0.01f;
  42:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             if(peak > 0.99f) peak = 0.99f;
  43:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  44:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Costruzione dell'onda morfologica
  45:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             if(phase_ < peak) {
  46:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****                 // Rampa di salita (da -1 a 1)
  47:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****                 out = -1.0f + (phase_ / peak) * 2.0f; 
  48:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             } else {
  49:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****                 // Rampa di discesa (da 1 a -1)
  50:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****                 out = 1.0f - ((phase_ - peak) / (1.0f - peak)) * 2.0f; 
  51:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             }
  52:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             break;
  53:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         }
  54:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         
  55:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_RAMP: out = ((phase_ * 2.0f)) - 1.0f; break;
  56:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_SQUARE: out = phase_ < shape_ ? (1.0f) : -1.0f; break;
  57:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         
  58:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_POLYBLEP_TRI:
  59:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             t   = phase_;
  60:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out = phase_ < 0.5f ? 1.0f : -1.0f;
  61:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out += Polyblep(phase_inc_, t);
  62:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out -= Polyblep(phase_inc_, daisysp::fastmod1f(t + 0.5f));
  63:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Leaky Integrator:
  64:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out       = phase_inc_ * out + (1.0f - phase_inc_) * last_out_;
  65:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             last_out_ = out;
  66:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out *= 4.f; 
  67:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             break;
  68:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  69:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_POLYBLEP_SAW:
  70:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             t   = phase_;
