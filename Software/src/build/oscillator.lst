  34:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** //Convert from semitones to other units. e.g. 2 ^ (kOneTwelfth * x)
  35:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** static constexpr float kOneTwelfth = 1.f / 12.f;
  36:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** 
  37:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** /** efficient floating point min/max
  38:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** c/o stephen mccaul
  39:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** */
  40:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float fmax(float a, float b)
  41:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
  42:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     float r;
  43:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** #ifdef __arm__
  44:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     asm("vmaxnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
  45:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** #else
  46:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     r = (a > b) ? a : b;
  47:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** #endif // __arm__
  48:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return r;
