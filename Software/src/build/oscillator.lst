  56:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** #else
  57:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     r = (a < b) ? a : b;
  58:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** #endif // __arm__
  59:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     return r;
