  72:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out -= Polyblep(phase_inc_, t);
  73:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out *= -1.0f;
  74:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             break;
  75:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  76:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_POLYBLEP_SQUARE:
  77:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             t   = phase_;
  78:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out = phase_ < shape_ ? 1.0f : -1.0f;
  79:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out += Polyblep(phase_inc_, t);
  80:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out -= Polyblep(phase_inc_, daisysp::fastmod1f(t + (1.0f - shape_)));
  81:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out *= 0.707f; 
  82:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             break;
  83:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  84:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         default: out = 0.0f; break;
  85:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****     }
