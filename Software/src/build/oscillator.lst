  18:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out = 2.0f * (fabsf(t) - 0.5f);
  19:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  20:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // WAVEFOLDING LIMITATO
  21:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // shape_ (0.0 -> 1.0) imposta un moltiplicatore da 1.0x a 1.9x
  22:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Fermandosi a 1.9x, la punta ripiegata arriva a 0.1 (o -0.1) e non attraversa lo zero
  23:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             float fold_gain = 1.0f + (shape_ * 0.9f); 
  24:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out *= fold_gain;
  25:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  26:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Algoritmo di fold: con un gain massimo di 1.9x non serve più il while().
  27:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Bastano due if, riducendo il carico sulla CPU.
  28:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             if(out > 1.0f) {
  29:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****                 out = 2.0f - out;
  30:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             } 
  31:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             else if(out < -1.0f) {
