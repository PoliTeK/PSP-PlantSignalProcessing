  39:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** */
  40:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** inline float fmax(float a, float b)
  41:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h **** {
  42:../libs/PoliTeKDSP/libs/DaisySP/Source/Utility/dsp.h ****     float r;
