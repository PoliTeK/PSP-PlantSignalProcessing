   9:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****     float out, t;
  10:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****     switch(waveform_)
  11:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****     {
  12:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_SIN: out = sinf(phase_ * TWOPI_F); break;
  13:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         
  14:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         case WAVE_TRI:
  15:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****         {
  16:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Generazione del Triangolo base
  17:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             t   = -1.0f + (2.0f * phase_);
  18:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out = 2.0f * (fabsf(t) - 0.5f);
  19:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  20:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // WAVEFOLDING: controllato da shape_
  21:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // shape_ (0.0 -> 1.0) imposta un moltiplicatore di gain da 1x a 5x
  22:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             float fold_gain = 1.0f + (shape_ * 4.0f);
  23:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             out *= fold_gain;
  24:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             
  25:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             // Algoritmo di fold: se il segnale supera l'ampiezza 1.0 o -1.0, viene ripiegato
  26:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             while(out > 1.0f || out < -1.0f)
  27:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             {
  28:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****                 if(out > 1.0f) out = 2.0f - out;
  29:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****                 if(out < -1.0f) out = -2.0f - out;
  30:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             }
  31:../libs/PoliTeKDSP/Oscillators/oscillator.cpp ****             break;
